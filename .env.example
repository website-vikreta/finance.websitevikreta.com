# Copy to .env.local and fill in. Never commit .env.local.
# Only NEXT_PUBLIC_* values reach the browser. Everything else stays on the server.

# ─── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database (SRS base plan: MongoDB, not final) ──────────────
DATABASE_URL=mongodb://localhost:27017/finance

# ─── Auth (F1, provider not chosen yet) ────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ─── Chatbot (F5, LLM provider not chosen yet) ─────────────────
LLM_API_KEY=

# ─── Exchange rates (USD → INR, source not chosen yet) ─────────
EXCHANGE_RATE_API_KEY=

# ─── Automation (n8n, owned by the automation team) ────────────
N8N_WEBHOOK_URL=
