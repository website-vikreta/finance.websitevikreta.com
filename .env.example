# ─── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database (decided: PostgreSQL) ────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/finance_wv

# ─── Auth (F1 — hardcoded admin user, single Next.js repo) ─────
# ADMIN_EMAIL: the hardcoded admin email
# ADMIN_PASSWORD_HASH: SHA-256 hex digest of the plaintext password
#   Generate: node -e "require('crypto').createHash('sha256').update('yourpassword').digest('hex')" | Write-Host
# JWT_SECRET: random 32-byte base64 string
#   Generate: node -e "require('crypto').randomBytes(32).toString('base64')" | Write-Host
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
JWT_SECRET=

# ─── Chatbot (F5) — Gemini API ────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional model override (defaults to waterfall: gemini-3.5-flash-lite -> gemini-3.5-flash -> gemini-3.8-flash)
GEMINI_MODEL=

# ─── Exchange rates (USD → INR, source not chosen yet) ─────────
EXCHANGE_RATE_API_KEY=

# ─── Automation (n8n, owned by the automation team) ────────────
N8N_WEBHOOK_URL=
